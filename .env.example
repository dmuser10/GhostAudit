# Required. Supabase Postgres connection string.
# Supabase dashboard > Connect > "Transaction pooler" (port 6543). Replace [YOUR-PASSWORD]
# with the database password (Project Settings > Database > Reset database password if unknown).
# A Session pooler URL (port 5432) also works: the app switches it to 6543, because
# session mode runs out of connections on Vercel (EMAXCONNSESSION).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Optional. Postgres schema for the app's tables (created automatically on start).
GHOSTAUDIT_SCHEMA=ghostaudit
# Optional. With a key, the Extractor Agent uses Claude to read receipt images,
# PDFs and text. Without it, the app uses offline OCR + rule-based extraction.
ANTHROPIC_API_KEY=
# Optional model override.
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=4000
